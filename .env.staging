# Staging build (`npm run build:staging`, and CI's staging build check).
#
# Vercel environment variables override this file, so the dashboard is the source of truth for
# deployed staging. This exists so a staging build can be produced locally and in CI without
# depending on Vercel's settings.
VITE_API_BASE_URL=https://stagingapi.radarproapp.com
VITE_ENVIRONMENT=staging
